<Window x:Class="DafeiyuPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大肥鱼桌宠"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root" Background="Transparent" Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 气泡：不挡点击，鼠标穿透 -->
        <Grid x:Name="BubbleHost" Grid.Row="0" HorizontalAlignment="Center"
              Margin="0,0,0,2" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BubbleShift" Y="0"/>
            </Grid.RenderTransform>
            <StackPanel>
                <Border x:Name="Bubble" Background="#F20E2338" BorderBrush="#662C6A8F"
                        BorderThickness="1" CornerRadius="14" Padding="14,10" MaxWidth="340">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <TextBlock x:Name="BubbleText" Foreground="#E4F3FF" FontSize="13.5"
                               TextWrapping="Wrap" LineHeight="21" FontFamily="Microsoft YaHei UI"/>
                </Border>
                <Path Fill="#F20E2338" Data="M 0,0 L 18,0 L 9,11 Z"
                      HorizontalAlignment="Center" Margin="0,-1,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 鱼本体 -->
        <Grid x:Name="PetHost" Grid.Row="1" RenderTransformOrigin="0.5,1" Background="Transparent">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PetShift" X="0" Y="0"/>
                    <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="PetTilt" Angle="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="PetImage" Source="assets/feiyu.png" Width="230" Height="228"
                   Stretch="Uniform" Cursor="Hand"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="左键拖动 · 双击收进托盘 · 右键菜单 · 滚轮缩放"/>
        </Grid>
    </Grid>
</Window>
