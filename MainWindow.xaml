<Window x:Class="DafeiyuPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大肥鱼桌宠"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root" Background="Transparent" Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 气泡：不挡点击，鼠标穿透 -->
        <Grid x:Name="BubbleHost" Grid.Row="0" HorizontalAlignment="Center"
              Margin="0,0,0,2" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BubbleShift" Y="0"/>
            </Grid.RenderTransform>
            <StackPanel>
                <Border x:Name="Bubble" Background="#F20E2338" BorderBrush="#662C6A8F"
                        BorderThickness="1" CornerRadius="14" Padding="14,10" MaxWidth="340">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <TextBlock x:Name="BubbleText" Foreground="#E4F3FF" FontSize="13.5"
                               TextWrapping="Wrap" LineHeight="21" FontFamily="Microsoft YaHei UI"/>
                </Border>
                <Path Fill="#F20E2338" Data="M 0,0 L 18,0 L 9,11 Z"
                      HorizontalAlignment="Center" Margin="0,-1,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 鱼本体 -->
        <Grid x:Name="PetHost" Grid.Row="1" RenderTransformOrigin="0.5,1" Background="Transparent">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PetShift" X="0" Y="0"/>
                    <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="PetTilt" Angle="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="PetImage" Source="assets/feiyu.png" Width="230" Height="228"
                   Stretch="Uniform" Cursor="Hand"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="按住左键：跟她说话 · 拖动：挪位置 · 双击：收起 · 右键：菜单 · 滚轮：缩放"/>

            <!-- 正在听：按住左键时冒出来的一小块。以后要换动态表情，先这么着。 -->
            <Border x:Name="ListenBadge" Visibility="Collapsed" VerticalAlignment="Top"
                    HorizontalAlignment="Center" Margin="0,4,0,0" Padding="11,5"
                    CornerRadius="13" Background="#F20E2338" BorderBrush="#66FF6B6B"
                    BorderThickness="1" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ListenDot" Width="9" Height="9" Fill="#FFFF5A5A"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="ListenText" Text="正在听…" Margin="7,0,0,0"
                               Foreground="#FFFFE9E9" FontSize="12.5"
                               FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
