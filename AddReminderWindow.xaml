<Window x:Class="DafeiyuPet.AddReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记一条提醒" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#0B1A2A" Foreground="#E4F3FF"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="提醒什么？" Foreground="#8AA4BF" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtWhat" Padding="6,5" Background="#10263D" Foreground="#E4F3FF"
                 BorderBrush="#2C6A8F" CaretBrush="#E4F3FF"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="几点（HH:mm）" Foreground="#8AA4BF" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTime" Padding="6,5" Background="#10263D" Foreground="#E4F3FF"
                         BorderBrush="#2C6A8F" CaretBrush="#E4F3FF"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="重复" Foreground="#8AA4BF" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbRepeat" SelectedIndex="0" Padding="6,5">
                    <ComboBoxItem Content="每天"/>
                    <ComboBoxItem Content="只一次"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="DateRow" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="哪天（yyyy-MM-dd）" Foreground="#8AA4BF" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDate" Padding="6,5" Background="#10263D" Foreground="#E4F3FF"
                     BorderBrush="#2C6A8F" CaretBrush="#E4F3FF"/>
        </StackPanel>

        <TextBlock x:Name="Err" Foreground="#FFBEB8" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="76" Margin="0,0,8,0" Padding="0,5" Click="OnCancel"/>
            <Button Content="记下" Width="76" Padding="0,5" Click="OnOk" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
